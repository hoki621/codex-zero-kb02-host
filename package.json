{
  "name": "codex-zero-kb02-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dry-run": "npm run build && node dist/src/dry-run.js",
    "install-codex-hook": "npm run build && node dist/src/codex-hook.js --install",
    "start": "npm run build && node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
